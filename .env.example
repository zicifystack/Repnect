# ── Server-only variables ($env/static/private) ──────────────────────────────

# GitHub OAuth (for submission form and star button)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GitHub Personal Access Token (used by CI scripts: enrich.ts, validate.ts)
GITHUB_TOKEN=""

# Session signing key — generate with: openssl rand -hex 32
SESSION_SECRET=""

# GitHub repo target for PR creation via guided form
GITHUB_REPO_OWNER="zicifystack"
GITHUB_REPO_NAME="repnect"

# ── Database (Cloudflare D1 + Drizzle) ───────────────────────────────────
# DATABASE_URL is used ONLY by drizzle-kit for LOCAL operations:
#   - `drizzle-kit generate` (reads schema, no DB needed)
#   - `drizzle-kit push`     (pushes schema to local SQLite)
#   - `drizzle-kit studio`   (browse local DB)
#
# Miniflare (local dev) stores the local D1 SQLite file here:
DATABASE_URL=".wrangler/state/v3/d1/miniflare-D1DatabaseObject/local.sqlite"
#
# NOTE: At runtime (Cloudflare Pages / wrangler dev), the DB is provided
#       via the `DB` binding in wrangler.toml — NOT via DATABASE_URL.
#
# D1 setup:
#   1. pnpm db:create                           # Create remote D1 DB
#   2. pnpm db:migrate:local                     # Run migrations locally
#   3. pnpm db:migrate:remote                  # Run migrations remotely

# Better Auth secret — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=""

# ── Public variables ($env/static/public) ───────────────────────────────────

# Canonical base URL — no trailing slash
PUBLIC_SITE_URL="https://repnect.dev"

# Vercel Analytics (set to "true" to enable)
PUBLIC_VERCEL_ANALYTICS=""

# Vercel Speed Insights (set to "true" to enable)
PUBLIC_VERCEL_SPEED_INSIGHTS=""

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
PUBLIC_GA_MEASUREMENT_ID=""
