# ── Server-only variables ($env/static/private) ──────────────────────────────

# GitHub OAuth (for submission form and star button)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GitHub Personal Access Token (used by CI scripts: enrich.ts, validate.ts)
GITHUB_TOKEN=""

# Session signing key — generate with: openssl rand -hex 32
SESSION_SECRET=""

# GitHub repo target for PR creation via guided form
GITHUB_REPO_OWNER="wbfoss"
GITHUB_REPO_NAME="repnect"

# Database (Drizzle / better-sqlite3)
DATABASE_URL="local.db"

# Better Auth
BETTER_AUTH_SECRET=""

# ── Public variables ($env/static/public) ────────────────────────────────────

# Canonical base URL — no trailing slash
PUBLIC_SITE_URL="https://repnect.dev"

# Vercel Analytics (set to "true" to enable)
PUBLIC_VERCEL_ANALYTICS=""

# Vercel Speed Insights (set to "true" to enable)
PUBLIC_VERCEL_SPEED_INSIGHTS=""

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
PUBLIC_GA_MEASUREMENT_ID=""
